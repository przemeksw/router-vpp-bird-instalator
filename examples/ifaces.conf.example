# /etc/router/ifaces.conf — przykład (router-on-a-stick, jeden port 100G)
# Po edycji na routerze:  router-ifaces diff   →   router-ifaces apply
# MTU: zawsze standardowe 1500 — nie wpisuj mtu=.
# Kilka adresów na jednym interfejsie: po przecinku, bez spacji (np. 192.0.2.2/30,203.0.113.65/27).
#   Kilka adresów z TEJ SAMEJ podsieci tylko z tą samą maską (np. .1/24 i .2/24); różne podsieci — dowolnie.
# IPv6: tylko tam, gdzie wpiszesz adres. "-" w kolumnie ipv6 = IPv6 na tym interfejsie całkowicie wyłączone.
#   Router nie wysyła RA (nie adresuje innych urządzeń) i nie przyjmuje cudzych RA.
#
# interfejs  vlan  ipv4               ipv6                     opis
hu0          -     -                  -                        Port 100G: trunk VLAN do switcha
hu0          100   192.0.2.2/30       2001:db8:100::2/64       Transit: EPIX AS62081
hu0          200   198.51.100.2/30    2001:db8:200::2/64       Transit: Upstream-2 10G
hu0          300   10.255.0.1/30      -                        Core: ASR1001-X BNG
hu0          400   203.0.113.65/27,198.51.100.129/28   2001:db8:400::1/64,2001:db8:401::1/64   Cust: klient X (dwie podsieci)
loop0        -     203.0.113.1/32     2001:db8::1/128          Loopback: router-id, BGP, SNMP
